{
    "name": "zerofront/module-zero-product-feed",
    "description": "Zero for Magento Open Source: the catalog as XML feeds for Google Merchant Center, Hotline, Rozetka and Prom.ua, one per store view.",
    "type": "magento2-module",
    "version": "1.3.4",
    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],
    "authors": [
        {
            "name": "Roman Pasichnyk"
        }
    ],
    "homepage": "https://zerofront.dev",
    "keywords": [
        "magento",
        "magento2",
        "magento-open-source",
        "zero",
        "product-feed",
        "google-merchant",
        "xml-feed"
    ],
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0",
        "magento/framework": "103.0.*",
        "magento/module-backend": "*",
        "magento/module-catalog": "*",
        "magento/module-catalog-inventory": "*",
        "magento/module-config": "*",
        "magento/module-configurable-product": "*",
        "magento/module-cron": "*",
        "magento/module-store": "*",
        "zerofront/module-zero-core": "^1.3"
    },
    "replace": {
        "fixstacks/module-zero-product-feed": "self.version"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Zero\\ProductFeed\\": ""
        }
    }
}
